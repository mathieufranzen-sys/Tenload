# ─── Supabase ───────────────────────────────────────────────────────────────
# Tableau de bord Supabase > Project Settings > API
# La clé "anon" est publique par nature : elle est protégée par les règles RLS.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── Rappels du carnet ──────────────────────────────────────────────────────
# Clé PUBLIQUE VAPID, générée par : npx web-push generate-vapid-keys
# Publique par construction : elle part dans chaque abonnement push.
# La clé PRIVÉE ne va PAS ici — elle vit dans les secrets de l'Edge Function :
#   supabase secrets set VAPID_PRIVATE_KEY=…
VITE_VAPID_PUBLIC_KEY=
