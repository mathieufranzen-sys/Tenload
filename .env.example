# ─── Supabase ───────────────────────────────────────────────────────────────
# Tableau de bord Supabase > Project Settings > API
# La clé "anon" est publique par nature : elle est protégée par les règles RLS.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── Strava (étape 5 du README, pas nécessaire pour démarrer) ───────────────
# https://www.strava.com/settings/api
# Ces deux-là sont côté SERVEUR uniquement : jamais de préfixe VITE_,
# sinon elles se retrouvent dans le bundle du navigateur.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# L'identifiant public peut être exposé, il sert à construire l'URL d'autorisation.
VITE_STRAVA_CLIENT_ID=

# Clé de service Supabase — SERVEUR UNIQUEMENT, ne jamais préfixer par VITE_.
# Elle contourne les règles RLS : elle ne doit exister que dans les variables
# d'environnement Netlify, jamais dans le code ni dans le dépôt.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
